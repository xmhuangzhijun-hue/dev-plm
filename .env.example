# Values below must be filled locally. Only SEC references, paths and nonsecret settings.
# Database admin / API / sync secret registry IDs (SEC-YYYY-NNN)
DEVPLM_DB_ADMIN_SECRET=
DEVPLM_DB_API_SECRET=
DEVPLM_DB_SYNC_SECRET=
# JWT signing secret registry ID
DEVPLM_JWT_SECRET=
# Path to registered admin password file for Docker Compose secret mount
DEVPLM_POSTGRES_PASSWORD_FILE=
# Dedicated D-drive PostgreSQL data directory (not inside the Git repository)
DEVPLM_PG_DATA=
# Local database name, host, port and distinct login names
DEVPLM_DB_NAME=
DEVPLM_DB_HOST=
DEVPLM_DB_PORT=
DEVPLM_DB_ADMIN_USER=
DEVPLM_DB_API_USER=
DEVPLM_DB_SYNC_USER=
# Nonsecret local identifier/tenant/principal/credential_ref mapping JSON
DEVPLM_ACCOUNTS_FILE=
# Optional data roots separated by the platform path separator (; on Windows)
DEVPLM_DATA_ROOTS=
